# Copia este archivo a .env.local y ajusta los valores.

# URL del backend NestJS (WebSocket). En LAN, usar la IP local de la
# máquina que corre el backend, no `localhost` — los celulares de los
# jugadores necesitan poder resolverla desde su propia red WiFi.
NEXT_PUBLIC_WS_URL=http://192.168.1.100:3001

# Base pública de la app usada para armar la URL del QR de invitación.
# Si se omite, se usa `window.location.origin` (sirve si el host ya abrió
# la pantalla por su IP LAN en vez de `localhost`).
NEXT_PUBLIC_APP_URL=http://192.168.1.100:3000
