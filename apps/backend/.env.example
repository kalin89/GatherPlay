# Copia este archivo a .env y ajusta los valores.
DATABASE_URL="postgresql://user:password@localhost:5432/gatherplay?schema=public"

# Puerto del backend NestJS (WebSocket + HTTP). 3001 para no chocar con
# el puerto por defecto de `next dev` (3000) al correr ambos en local.
PORT=3001

# Credencial de la API de Anthropic (Claude), usada por AiContentModule para
# generar preguntas de Trivia. Si se omite, se usa directamente el banco de
# preguntas de respaldo (apps/backend/src/ai-content/trivia-fallback-bank.ts)
# sin intentar llamar a la IA — así funcionan dev, CI y los tests e2e sin key.
ANTHROPIC_API_KEY=

# Ciclo de vida de las salas (todas opcionales, enteros positivos; un valor
# inválido hace fallar el arranque). Ver specs/features/room-lifecycle/analysis.md.
# Tiempo (ms) sin ninguna pantalla de host conectada antes de cerrar la sala.
# ROOM_HOST_GRACE_MS=120000
# Vida máxima (ms) de una sala, aunque haya gente conectada.
# ROOM_MAX_AGE_MS=43200000
# Tope de salas simultáneas en el proceso.
# MAX_ROOMS=200
# Cada cuánto (ms) se revisa qué salas expiraron.
# ROOM_SWEEP_INTERVAL_MS=30000
