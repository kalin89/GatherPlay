# Copia este archivo a .env y ajusta los valores.
DATABASE_URL="postgresql://user:password@localhost:5432/gatherplay?schema=public"

# Puerto del backend NestJS (WebSocket + HTTP). 3001 para no chocar con
# el puerto por defecto de `next dev` (3000) al correr ambos en local.
PORT=3001

# Credencial de la API de Anthropic (Claude), usada por AiContentModule para
# generar preguntas de Trivia. Si se omite, se usa directamente el banco de
# preguntas de respaldo (apps/backend/src/ai-content/trivia-fallback-bank.ts)
# sin intentar llamar a la IA — así funcionan dev, CI y los tests e2e sin key.
ANTHROPIC_API_KEY=
